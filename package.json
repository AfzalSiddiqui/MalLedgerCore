{
  "name": "malledgercore",
  "version": "1.0.0",
  "description": "In-memory financial ledger core for value-dated transactions, account balances, authorization holds, settlements, reversals, fees, and interest accrual.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "replay": "tsc && node dist/src/run.js",
    "test": "vitest run --exclude tests/known-gap.test.ts",
